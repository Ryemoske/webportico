# Copia este archivo como .env en el servidor y rellénalo. No subas el .env a git.

# Clave secreta larga y aleatoria. Genérala con:
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# En producción, False (o no lo pongas). En un PC de desarrollo, True.
DJANGO_DEBUG=False

# Dominios desde los que se sirve la app, separados por comas
DJANGO_ALLOWED_HOSTS=porticos.idnn.es

# Orígenes de confianza para los formularios y peticiones con CSRF (con https://)
DJANGO_CSRF_TRUSTED_ORIGINS=https://porticos.idnn.es

# Ruta de la base de datos SQLite. En Docker ya la fija compose.yml (/app/data/db.sqlite3,
# en un volumen); solo hace falta si quieres otra ubicación.
# DJANGO_SQLITE_PATH=/app/data/db.sqlite3
